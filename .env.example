# Скопируйте этот файл в .env и заполните.

# --- Почта (IMAP, SSL) ---
# Gmail:   imap.gmail.com  993
# Яндекс:  imap.yandex.ru  993
# Mail.ru: imap.mail.ru    993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=my@gmail.com
# Пароль приложения, НЕ основной пароль от почты
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Читаем письма только от этих адресов (один или несколько через запятую)
ALLOWED_SENDER=my@mail.ru
# 1 — принимать чеки от любых отправителей (по теме «чек» или отправителю-ОФД), 0 — только от ALLOWED_SENDER
ANY_SENDER=1

# Сколько дней назад смотреть и сколько писем максимум разбирать за одну проверку
SINCE_DAYS=7
MAX_EMAILS_PER_CHECK=50

# --- Claude API (необязательно) ---
# Если пусто, LLM-разбор пропускается
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Интерфейс ---
AUTO_REFRESH_MINUTES=10
DB_PATH=receipts.db
